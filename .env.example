# Copy to .env in the repository root. Never commit an actual key.
# OpenAI-compatible connection settings (replace these placeholders).
OPENAI_API_KEY=your-local-key
OPENAI_BASE_URL=https://your-compatible-server.example/v1
OPENAI_MODEL=your-model-id
# Use the API base URL, not /chat/completions. Host-only URLs receive /v1.
# If OPENAI_BASE_URL is empty, compatible defaults to https://api.openai.com/v1.

# Optional configuration overrides are documented in codebase/README.md.
